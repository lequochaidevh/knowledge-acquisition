[submodule "third-party/fmt"]
	path = third-party/fmt
	url = https://github.com/fmtlib/fmt.git
[submodule "third-party/googletest"]
	path = third-party/googletest
	url = https://github.com/google/googletest.git
[submodule "linux/private_lib/Haris_Engine_Library"]
	path = linux/private_lib/Haris_Engine_Library
	url = git@github.com:lequochaidevh/Haris_Engine_Library.git
[submodule "third-party/json"]
	path = third-party/json
	url = https://github.com/nlohmann/json.git
[submodule "third-party/FTXUI"]
	path = third-party/FTXUI
	url = https://github.com/ArthurSonzogni/FTXUI.git
[submodule "third-party/asio"]
	path = third-party/asio
	url = https://github.com/chriskohlhoff/asio.git
[submodule "third-party/gst-build"]
	path = third-party/gst-build
	url = https://github.com/GStreamer/gst-build.git
[submodule "third-party/libexif"]
	path = third-party/libexif
	url = https://github.com/libexif/libexif.git
