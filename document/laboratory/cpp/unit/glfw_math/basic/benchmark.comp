#version 430 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(location = 0) uniform int M;
layout(location = 1) uniform int N;
layout(location = 2) uniform int K;

layout(std430, binding = 0) readonly buffer BufferA { float A[]; };
layout(std430, binding = 1) readonly buffer BufferB { float B[]; };
layout(std430, binding = 2) writeonly buffer BufferC { float C[]; };

// Shared memory allocations accessible inside the 16x16 local work group
shared float Asub[16][16];
shared float Bsub[16][16];

void main() {
    int row = int(gl_GlobalInvocationID.y);
    int col = int(gl_GlobalInvocationID.x);
    
    // Local identifiers inside the current thread block
    int localRow = int(gl_LocalInvocationID.y);
    int localCol = int(gl_LocalInvocationID.x);

    float sum = 0.0;

    // Loop over all historical tiles needed to calculate this element
    int numTiles = (N + 15) / 16;
    for (int t = 0; t < numTiles; ++t) {
        
        // 1. Collaboratively load elements from VRAM into fast Shared Memory
        int globalColA = t * 16 + localCol;
        if (row < M && globalColA < N) {
            Asub[localRow][localCol] = A[row * N + globalColA];
        } else {
            Asub[localRow][localCol] = 0.0;
        }

        int globalRowB = t * 16 + localRow;
        if (globalRowB < N && col < K) {
            Bsub[localRow][localCol] = B[globalRowB * K + col];
        } else {
            Bsub[localRow][localCol] = 0.0;
        }

        // Synchronize all threads in this block before doing math!
        barrier();

        // 2. Multiply the tiles from cache (Extremely fast)
        for (int k = 0; k < 16; ++k) {
            sum += Asub[localRow][k] * Bsub[k][localCol];
        }

        // Synchronize again before loading the next tile block
        barrier();
    }

    // Write final accumulated sum to VRAM
    if (row < M && col < K) {
        C[row * K + col] = sum;
    }
}